{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ivanfuhr/laravel-result",
    "description": "A typed success/failure Result for Laravel service and action outcomes.",
    "keywords": [
        "php",
        "laravel",
        "package",
        "result",
        "success",
        "failure",
        "enum",
        "laravel-result"
    ],
    "homepage": "https://github.com/ivanfuhr/laravel-result",
    "license": "MIT",
    "authors": [
        {
            "name": "Ivan Führ",
            "email": "dev.ivanfuhr@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.4",
        "tomasvotruba/type-coverage": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "IvanFuhr\\Result\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "IvanFuhr\\Result\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "refactor": [
            "rector"
        ],
        "lint": [
            "pint --parallel"
        ],
        "test:refactor": [
            "rector --dry-run"
        ],
        "test:lint": [
            "pint --parallel --test"
        ],
        "lint:check": [
            "@test:lint"
        ],
        "analyse": [
            "phpstan analyse --ansi --memory-limit=512M"
        ],
        "test:types": [
            "@analyse"
        ],
        "test:type-coverage": [
            "pest --type-coverage --min=100"
        ],
        "test:unit": [
            "pest --colors=always --parallel"
        ],
        "test:coverage": [
            "pest --colors=always --coverage --parallel --min=100"
        ],
        "test": [
            "@test:refactor",
            "@test:lint",
            "@analyse",
            "@test:type-coverage",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "IvanFuhr\\Result\\ResultServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
